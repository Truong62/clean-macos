    <item>
      <title>Version 1.0.6</title>
      <pubDate>Tue, 26 May 2026 17:07:39 +0700</pubDate>
      <sparkle:version>7</sparkle:version>
      <sparkle:shortVersionString>1.0.6</sparkle:shortVersionString>
      <description><![CDATA[
        <h2>What's new in 1.0.6</h2>
        <ul>
          <li>Closing the window now <b>keeps Clean macOS running in the background</b> — your clipboard history and the ⌘⇧V picker keep working. Click the Dock icon to reopen the window; ⌘Q quits fully.</li>
        </ul>
      ]]></description>
